# A public Telegram channel username without @. For example: heyue151
TG_CHANNEL=

# DingTalk custom robot. Enable signing in DingTalk and supply both values.
DINGTALK_WEBHOOK_URL=
DINGTALK_SIGNING_SECRET=

# Supabase project URL and a server-side secret key (sb_secret_...). Do not use the anon key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional behaviour. The default skips existing posts on the first successful run.
# Set to send_recent only when you deliberately want a small recent-history backfill.
INITIAL_SYNC_MODE=skip
INITIAL_HISTORY_LIMIT=10
MAX_MESSAGES_PER_RUN=100
PUBLIC_PREVIEW_MAX_PAGES=20
